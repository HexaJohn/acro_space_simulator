# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# FVM (pinned SDK cache — .fvmrc IS committed)
.fvm/

# Licensed 3D model assets — NOT redistributable, keep local only.
# .glb = purchased source; .fsceneb = baked ship-format (tool/import_mesh.dart).
# Both stay out of the repo; app falls back to procedural parts without them.
*.glb
*.fsceneb

# Raw DEM/albedo source rasters — gigabytes of working data in dem_src/ that
# gets BAKED into a small shipped tile pyramid, exactly like the .glb ->
# .fsceneb path above. Never commit the source; never bundle it. (dem_src/
# deliberately sits outside assets/, which pubspec packages wholesale.)
*.tif
*.tiff

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Diagnostic screenshot harness output (regenerated by sphere_diag_test.dart)
/test_out/

# VS Code Counter extension output
.VSCodeCounter/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Claude Code local memory / plans / session data
.claude/

# Generated dartdoc API site (regenerate with: dart doc --output doc/api)
doc/api/
