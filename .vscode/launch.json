{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "macOS (Impeller)",
      "request": "launch",
      "type": "dart",
      "deviceId": "macos",
      // Impeller (Metal) is already the macOS default, but Flutter GPU — the
      // API flutter_scene renders through — is opt-in everywhere and is only
      // supported on Impeller. Both are passed explicitly so the requirement
      // is documented and survives any change to the platform default.
      "args": ["--enable-impeller", "--enable-flutter-gpu"]
    },
    {
      "name": "Windows (Impeller)",
      "request": "launch",
      "type": "dart",
      "deviceId": "windows",
      // flutter_scene renders through Impeller + Flutter GPU; neither is
      // default on Windows desktop yet, so both must be enabled explicitly.
      "args": ["--enable-impeller", "--enable-flutter-gpu"]
    },
    {
      "name": "Windows (software renderer only)",
      "request": "launch",
      "type": "dart",
      "deviceId": "windows"
    },
    {
      "name": "Chrome (web)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "program": "lib/main.dart"
      // NOTE: main_scene_dev.dart is NOT web-launchable — its screenshot
      // service extension writes files via dart:io.
    }
  ]
}
